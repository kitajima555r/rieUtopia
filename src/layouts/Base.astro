---
import "../styles/global.css";
import { absoluteUrl } from "../lib/posts";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  current?: "poems" | "about";
}

const {
  title,
  description,
  path,
  image = "/images/eyecatch-ohayo.jpg",
  type = "website",
  jsonLd,
  current,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(image);
const fullTitle = path === "/" ? title : `${title} | Rie-Utopia`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0W215WX6JL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0W215WX6JL');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Rie-Utopia" href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rie-Utopia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo" aria-label="Rie-Utopia トップへ">
          <img src="/images/rie-utopia-logo.png" alt="Rie-Utopia" />
        </a>
        <nav class="nav" aria-label="メインメニュー">
          <a href="/poems" aria-current={current === "poems" ? "page" : undefined}>詩を読む</a>
          <a href="/#about" aria-current={current === "about" ? "page" : undefined}>About</a>
          <a href="https://www.instagram.com/rieutopia/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <a href="/" class="logo" aria-label="Rie-Utopia トップへ">
          <img src="/images/rie-utopia-logo.png" alt="" />
        </a>
        <nav class="footer-nav" aria-label="フッターメニュー">
          <a href="/poems">詩を読む</a>
          <a href="/#about">About</a>
          <a href="https://www.instagram.com/rieutopia/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://twitter.com/rieUtopia" target="_blank" rel="noopener noreferrer">X</a>
          <a href="/feed.xml">RSS</a>
        </nav>
        <p class="copyright">&copy; RIE-Utopia</p>
      </div>
    </footer>
  </body>
</html>
