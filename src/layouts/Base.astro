---
import "../styles/global.css";
import { absoluteUrl } from "../lib/posts";
import { site, nav } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  current?: "poems" | "about";
}

const {
  title,
  description,
  path,
  image = "/images/eyecatch-ohayo.jpg",
  type = "website",
  jsonLd,
  current,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(image);
const v = `?v=${site.assetVersion}`;
const fullTitle = path === "/" ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0W215WX6JL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0W215WX6JL');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="icon" href={`/favicon.ico${v}`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/images/favicon-32.png${v}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/images/favicon-16.png${v}`} />
    <link rel="apple-touch-icon" href={`/images/apple-touch-icon.png${v}`} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i><i class="blob b4"></i>
    </div>

    <header>
      <nav class="pill" aria-label="メインメニュー">
        {nav.map((item) => (
          <a
            href={item.href}
            class={"primary" in item && item.primary ? "primary" : undefined}
            aria-current={
              (item.label === "詩を読む" && current === "poems") ||
              (item.label === "About" && current === "about")
                ? "page"
                : undefined
            }
            {...("external" in item && item.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer glass">
      <div class="footer-inner">
        <a href="/" aria-label={`${site.name} トップへ`}>
          <img src={`/images/rie-utopia-logo.png${v}`} alt="" />
        </a>
        <nav class="footer-nav" aria-label="フッターメニュー">
          <a href="/poems">詩を読む</a>
          <a href="/#about">About</a>
          <a href={site.links.instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={site.links.x.url} target="_blank" rel="noopener noreferrer">X</a>
          <a href={site.links.note.url} target="_blank" rel="noopener noreferrer">note</a>
          <a href="/feed.xml">RSS</a>
        </nav>
        <p class="copyright">&copy; {site.name}</p>
      </div>
    </footer>
  </body>
</html>
