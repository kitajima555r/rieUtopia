---
import { preview, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const text = `${post.title}\n${post.lines.join("\n")}`.toLowerCase();
---

<a
  class="card"
  href={`/posts/${post.id}.html`}
  data-category={post.category}
  data-text={text}
>
  <div class="card-thumb">
    {post.image && <img src={post.image} alt="" width="800" height="500" loading="lazy" />}
  </div>
  <div class="card-body">
    <div class="card-meta">
      <time datetime={post.date}>{post.date}</time>
      <span class="tag">{post.categoryLabel}</span>
    </div>
    <h3>{post.title}</h3>
    <p class="card-preview">{preview(post)}</p>
  </div>
</a>
