---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";
import { getNoteArticles } from "../lib/note";
import { site } from "../data/site";

const posts = await getPosts();
const poems = posts.filter((p) => p.category === "poem");
const recent = poems.slice(0, 6);
const noteArticles = await getNoteArticles(3);
const [noteMain, ...noteRest] = noteArticles;
const quoteSource = posts.find((p) => p.title.includes(site.quote.sourceTitle));
const { instagram, x, note } = site.links;
---

<Base
  title={`${site.name} | 詩人 ${site.penName} の詩を読む場所`}
  description={site.description}
  path="/"
>
  <!-- Hero -->
  <section class="hero">
    <img class="wordmark" src="/images/rie-utopia-logo.png" alt={site.name} width="900" height="268" />
    <h1 class="tagline">
      {site.tagline.map((line) => <span>{line}</span>)}
    </h1>
    <div class="hero-links">
      <a class="btn" href="/poems">詩を読む</a>
      <a class="text-link" href="#about">詩人について →</a>
    </div>
    <p class="hero-count"><b>{poems.length}</b> 編の詩 ・ <b>{posts.length}</b> 作品</p>
    <span class="hint">scroll</span>
  </section>

  <!-- 新着の詩 -->
  <section class="section wrap" id="new">
    <div class="head">
      <div class="glass head-box">
        <span class="eyebrow">New Poems</span>
        <h2 class="title">新着の詩</h2>
      </div>
      <a class="text-link" href="/poems">すべての詩を見る →</a>
    </div>
    <div class="rail" tabindex="0" role="region" aria-label="新着の詩">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- About + 引用 -->
  <section class="section wrap two" id="about">
    <div class="glass about">
      <span class="eyebrow">About</span>
      <h2 class="title">{site.penName}</h2>
      <p class="about-role">{site.role} ／ {site.name}</p>
      <div class="about-body">
        {site.about.paragraphs.map((text) => <p>{text}</p>)}
        <p class="about-note">{site.about.note}</p>
      </div>
      <div class="link-list">
        <a class="link-pill" href={instagram.url} target="_blank" rel="noopener noreferrer">{instagram.label} {instagram.handle}</a>
        <a class="link-pill" href={x.url} target="_blank" rel="noopener noreferrer">{x.label} {x.handle}</a>
        <a class="link-pill" href={note.url} target="_blank" rel="noopener noreferrer">{note.label} {note.handle}</a>
      </div>
    </div>
    <div class="glass quote">
      <div>
        <blockquote>{site.quote.lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</blockquote>
        {quoteSource && (
          <cite>— <a href={`/posts/${quoteSource.id}.html`}>{quoteSource.title}</a> より</cite>
        )}
      </div>
    </div>
  </section>

  <!-- note -->
  {noteMain && (
    <section class="section wrap" id="note">
      <div class="head">
        <div class="glass head-box">
          <span class="eyebrow">Essay</span>
          <h2 class="title">noteの最新記事</h2>
        </div>
        <a class="text-link" href={note.url} target="_blank" rel="noopener noreferrer">note でもっと読む →</a>
      </div>
      <div class="glass note">
        <a class="note-main" href={noteMain.url} target="_blank" rel="noopener noreferrer">
          <div class="note-main-thumb">
            {noteMain.image && <img src={noteMain.image} alt="" width="1200" height="750" loading="lazy" />}
          </div>
          <time datetime={noteMain.date}>{noteMain.date}</time>
          <h3>{noteMain.title}</h3>
        </a>
        <div class="note-side">
          {noteRest.map((article) => (
            <a class="note-item" href={article.url} target="_blank" rel="noopener noreferrer">
              <div class="note-item-thumb">
                {article.image && <img src={article.image} alt="" width="320" height="240" loading="lazy" />}
              </div>
              <div>
                <time datetime={article.date}>{article.date}</time>
                <h3>{article.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SNS -->
  <section class="section wrap" id="social">
    <div class="head">
      <div class="glass head-box">
        <span class="eyebrow">Social</span>
        <h2 class="title">最新の投稿</h2>
      </div>
    </div>
    <div class="social-grid">
      <div class="glass social-item">
        <h3>{instagram.label} <a href={instagram.url} target="_blank" rel="noopener noreferrer">{instagram.handle}</a></h3>
        <div class="embed">
          <iframe
            src={`${instagram.url}embed`}
            title={`${site.penName} (${instagram.handle}) の Instagram 最新投稿`}
            loading="lazy"
            scrolling="no"
            allowtransparency="true"></iframe>
        </div>
        <p class="embed-link">
          <a href={instagram.url} target="_blank" rel="noopener noreferrer">Instagram で全ての投稿を見る →</a>
        </p>
      </div>
      <div class="glass social-item">
        <h3>{x.label} <a href={x.url} target="_blank" rel="noopener noreferrer">{x.handle}</a></h3>
        <div class="embed embed-x">
          <a
            class="twitter-timeline"
            data-height="640"
            data-lang="ja"
            data-chrome="noheader nofooter noborders transparent"
            href={x.url}>{x.handle} の最新ポストを読み込み中…</a
          >
        </div>
        <p class="embed-link">
          <a href={x.url} target="_blank" rel="noopener noreferrer">X で最新のポストを見る →</a>
        </p>
      </div>
    </div>
  </section>
  <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>

  <!-- 日記 -->
  <section class="section wrap" id="journal">
    <div class="glass banner">
      <div>
        <span class="eyebrow">Journal</span>
        <h2 class="title">日記・記録</h2>
        <p>
          双極性障害とともに生きる日々の記録も綴っています。鬱期も躁期も、すべてが自分の言葉として残っていく場所。
        </p>
      </div>
      <a class="btn btn-solid" href="/poems?c=diary">日記を読む</a>
    </div>
  </section>
</Base>
